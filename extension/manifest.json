{
  "manifest_version": 3,
  "name": "Music Duck",
  "version": "0.1.0",
  "description": "Lowers YouTube Music by 67% while any other audio plays.",
  "key": "",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "https://music.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}